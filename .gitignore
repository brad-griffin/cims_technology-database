# What this repo does NOT track.
#
# The data is the point here, so nothing that matches a data file is listed:
# every .csv under data/, the generated review .md files and the review
# packages are all deliberately tracked, because a
# reviewer needs to see what a pipeline run changed. What is listed below is
# only what a tool writes for its own benefit and can regenerate from scratch.

# Python bytecode and tool caches. Every script here is run straight from the
# working tree (python -m technology_database.build), so these appear on any run
# and are pure noise in a diff.
__pycache__/
*.py[cod]
*$py.class
.mypy_cache/
.ruff_cache/
.pytest_cache/
.ipynb_checkpoints/

# Environments. Nothing in the pipeline depends on where the interpreter lives.
.venv/
venv/
env/
*.egg-info/

# marimo's scratch directory, written beside a notebook when one is run.
__marimo__/

# Excel and Word lock files: an open workbook leaves ~$name.xlsx beside it, and
# committing one records a file that exists only while the app is open.
~$*
*.tmp

# OS metadata.
.DS_Store
Thumbs.db
desktop.ini

# Primary sources: the documents, workbooks, saved web pages and bulk downloads
# the extractions come from. They are too large for git and are not on FRDR;
# each one is listed in the manifest (data/raw_data/technology_database/
# source-details_files.csv), and primary-sources/ mirrors the publisher folders
# of the raw data (Brad 2026-11-06).
primary-sources/
cims/reporting-accounting/context/*.xlsx

# Large derived extracts, regenerated by their extraction scripts from the bulk
# downloads in primary-sources/: kept beside the other extractions, not in git.
data/raw_data/technology_database/gov-usa/eia/prices/eia_2026_bulk-seds_prices.csv
data/raw_data/technology_database/gov-usa/eia/prices/eia_2026_bulk-elec_prices.csv
data/raw_data/technology_database/gov-can/petrinex/petrinex_2026_facility-metrics_ab-sk.csv

# the workbook is rebuilt from the CSVs on every build; its versions are not kept
# (Brad 2026-11-06)
data/processed_data/technology_database/technology-database.xlsx

# files the Claude app saves into the connected folder
Claude outputs/
